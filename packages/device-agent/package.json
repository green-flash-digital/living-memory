{
  "name": "@living-memory/device-agent",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:types": "yarn build:types --watch",
    "build": "tsc",
    "build:types": "yarn tsc --project ./tsconfig.types.json",
    "start": "node dist/index.js"
  },
  "exports": {
    "./types": {
      "types": "./dist/types.d.ts"
    }
  },
  "dependencies": {
    "@hono/node-server": "1.19.9",
    "@living-memories/api": "workspace:*",
    "@living-memory/utils": "workspace:*",
    "hono": "4.11.7"
  },
  "devDependencies": {
    "@types/node": "20.19.30",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
